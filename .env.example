LLM_PROVIDER=nvidia
LLM_MODEL_NAME=openai/gpt-oss-20b

# Required when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=

# Required when LLM_PROVIDER=gemini instead (LLM_MODEL_NAME e.g. gemini-2.0-flash)
GOOGLE_API_KEY=

GITHUB_TOKEN=

LOG_LEVEL=INFO
MAX_QA_RETRIES=3
VECTOR_DB_PATH=./data/vector_store
ENVIRONMENT=development
