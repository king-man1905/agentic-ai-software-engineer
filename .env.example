# --- Primary LLM provider ---------------------------------------------------
# LLM_PROVIDER selects which client get_llm() constructs as PRIMARY.
# Supported: nvidia, gemini, openai. Its own API key below is mandatory -
# validate_config() fails startup if the primary provider's key is missing.
LLM_PROVIDER=nvidia
LLM_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Required when LLM_PROVIDER=nvidia (mandatory for the primary provider).
NVIDIA_API_KEY=

# --- Fallback LLM provider (OPTIONAL) ---------------------------------------
# When the PRIMARY provider times out (LLMTimeoutError) or returns a
# transient/malformed response, get_fallback_provider() in
# backend/services/llm.py automatically selects the first CREDENTIALED
# alternative from GOOGLE_API_KEY (gemini) / OPENAI_API_KEY (openai), in
# that order, and retries once through that provider instead. This works
# for ANY primary provider, not just nvidia.
#
# A fallback credential is entirely OPTIONAL - the application runs
# correctly with only the primary provider's key set. If neither
# GOOGLE_API_KEY nor OPENAI_API_KEY is set, a primary-provider timeout or
# transient failure is INTENTIONALLY fail-closed (the run fails with a
# classified LLMTimeoutError instead of silently retrying nowhere) rather
# than pretending a fallback exists. GET /health/ready surfaces the
# current primary/fallback configuration under checks.llm_provider so this
# state is always visible, never silent.
#
# Set GOOGLE_API_KEY (or OPENAI_API_KEY) here to enable automatic fallback
# even while nvidia stays PRIMARY - you do not need to change LLM_PROVIDER.
# GOOGLE_API_KEY is also the PRIMARY key if you set LLM_PROVIDER=gemini
# instead (LLM_MODEL_NAME e.g. gemini-2.0-flash).
GOOGLE_API_KEY=
OPENAI_API_KEY=

GITHUB_TOKEN=

LOG_LEVEL=INFO
MAX_QA_RETRIES=3
VECTOR_DB_PATH=./data/vector_store
ENVIRONMENT=development
